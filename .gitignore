generated/
prisma/generated/

# 🗄 Database files (if any local)
*.sqlite
*.db

# 🖥 OS files
.DS_Store
Thumbs.db

# 🧠 IDE / Editor
.vscode/
.idea/

# 🔑 Keys & certificates (VERY IMPORTANT)
*.pem
*.key
*.crt

# 🧪 Temp files
tmp/
temp/

