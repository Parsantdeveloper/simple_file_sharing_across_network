{
  "compilerOptions": {
    "target": "ES2021",
    "module": "CommonJS",
    "lib": ["ES2021"],
    
    "rootDir": "src",           // your TS source folder
    "outDir": "dist",           // compiled JS goes to root/dist
    
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    "baseUrl": "./",            // base URL is project root
    "paths": {
      "@/*": ["src/*"]          // alias @/ → src/
    }
  },
  "include": ["src"],           // include source files only
  "exclude": ["node_modules", "dist"]
}